From d49761ebccb59c465be36f04c839a5b0b185408b Mon Sep 17 00:00:00 2001
From: gpu-bunk <noreply@example.invalid>
Date: Tue, 13 Oct 2026 06:19:13 -0400
Subject: [PATCH 5/5] Hold reclaimed blocks for the woken model until its
 admitted prefill completes

Without the hold, models trade the same blocks back and forth.
---
 vllm/v1/core/sched/meta_scheduler.py | 73 +++++++++++++++++++++++++++-
 vllm/v1/core/shared_kv.py            | 14 ++++++
 2 files changed, 86 insertions(+), 1 deletion(-)

diff --git a/vllm/v1/core/sched/meta_scheduler.py b/vllm/v1/core/sched/meta_scheduler.py
index 7ba3b12..62e1822 100644
--- a/vllm/v1/core/sched/meta_scheduler.py
+++ b/vllm/v1/core/sched/meta_scheduler.py
@@ -23,6 +23,14 @@ engines may have a batch launched at once from one thread. Two rules make that s
    A block a model frees in update_from_output is safe to hand out: that call runs
    after the host has synchronized on the model's sampled tokens, which are produced
    on the same stream after every KV write of that step (sync scheduling only).
+
+Hold: after a non-empty reclaim for W's head h, the reclaimed amount is HELD for
+W until h's admitted prefill completes: every other model's pool view reports that many
+fewer free blocks (`SharedKVPool.reservations`), shrinking as h allocates. Without it,
+under chunked prefill the borrower re-admits into the freed blocks before h's next chunk,
+h self-preempts and the reclaim fires again (ping-pong). The hold is released when h is
+gone (finished/aborted), its prefill completes, or after `hold_max_turns` of W's turns.
+(The hold logic runs inside the lock from patch 0004; the in-flight victim rule is kept.)
 """
 
 from __future__ import annotations
@@ -80,6 +88,26 @@ class MetaEvent:
     waiting_floor: int
 
 
+@dataclass
+class Hold:
