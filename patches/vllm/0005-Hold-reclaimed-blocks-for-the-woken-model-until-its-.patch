@@ -98,14 +132,43 @@ class MetaScheduler:
     def _need(self, sched, req) -> int:
         return cdiv(req.num_tokens, sched.block_size)
 
+    def _refresh_holds(self, model: str) -> None:
+        """Age the caller's holds, release finished ones, publish the remaining counts."""
+        for key in list(self.holds):
+            h = self.holds[key]
+            sched = self.engines[h.model]
+            if h.model == model:
+                h.age += 1
+            req = sched.requests.get(h.req_id)
+            reason = None
+            if req is None or req.is_finished():
+                reason = "gone"
+            elif req.num_computed_tokens >= h.prefill_tokens:
+                reason = "prefill_done"
+            elif h.age >= self.hold_max_turns:
+                reason = "timeout"
+            if reason is not None:
+                del self.holds[key]
+                self.hold_log.append(HoldRelease(self.turn, h.model, h.req_id, reason, h.age))
+                continue
+            h.remaining = max(0, h.target_blocks - self._req_blocks(sched, req))
+        res: dict[str, int] = {}
+        for h in self.holds.values():
+            res[h.model] = res.get(h.model, 0) + h.remaining
+        self.shared.reservations = res
+
     def arbitrate(self, model: str) -> None:
         with self.lock:
+            self.turn += 1
+            if self.holds or self.shared.reservations:
+                self._refresh_holds(model)
             sched = self.engines[model]
             if not sched.waiting:
                 return
             head = sched.waiting.peek_request()
             held = {m: self.shared.held(m) for m in self.engines}
-            free = self.shared.base.get_num_free_blocks()
+            free = max(0, self.shared.base.get_num_free_blocks()
+                       - sum(self.shared.reservations.values()))
             need = self._need(sched, head)
             victim_blocks = {
                 m: ([] if (m != model and m in self.in_flight) else
@@ -129,6 +192,14 @@ class MetaScheduler:
                 self.events.append(MetaEvent(self.step_no, model, victim,
                                              req.request_id, held[model],
                                              self.floors[model]))
+            if plan and self.hold:
+                h = Hold(model, head.request_id, need, head.num_tokens, self.turn)
+                h.remaining = max(0, need - self._req_blocks(sched, head))
+                self.holds[(model, head.request_id)] = h
+                self.holds_created += 1
+                res = dict(self.shared.reservations)
+                res[model] = sum(x.remaining for x in self.holds.values() if x.model == model)
+                self.shared.reservations = res
 
